#!/usr/bin/env python3
from __future__ import annotations
import argparse
import json
import sys
from pathlib import Path

from legacy_client import LegacyLabError, assess_legacy
from waf_runtime import evaluate_policy, load_policy


def read_request(path: str):
    try:
        data = json.loads(Path(path).read_text())
    except Exception as exc:
        raise SystemExit(f"cannot read request {path}: {exc}")
    if isinstance(data, dict) and "request" in data and isinstance(data["request"], dict):
        return data["request"]
    return data


def checked_policy(path: str):
    data, errors = load_policy(path)
    if errors:
        print(json.dumps({"valid": False, "errors": errors}, indent=2))
        raise SystemExit(2)
    return data


def command_check(args):
    data, errors = load_policy(args.policy)
    result = {
        "valid": not errors,
        "supported_predicates": ["locator_outside", "contains", "equals"],
        "error_count": len(errors),
        "errors": errors,
    }
    if not errors:
        result["summary"] = f"valid enforcement policy with {len(data['rules'])} rule(s)"
    print(json.dumps(result, indent=2))
    raise SystemExit(0 if not errors else 2)


def command_inspect(args):
    req = read_request(args.request)
    try:
        result = assess_legacy(req)
    except LegacyLabError as exc:
        raise SystemExit(str(exc))
    print(json.dumps(result, indent=2, ensure_ascii=False))


def command_probe(args):
    policy = checked_policy(args.policy)
    req = read_request(args.request)
    edge = evaluate_policy(policy, req)
    out = {"edge": edge}
    if edge["decision"] == "allow":
        try:
            out["upstream"] = assess_legacy(req)
        except LegacyLabError as exc:
            raise SystemExit(str(exc))
    print(json.dumps(out, indent=2, ensure_ascii=False))


def command_replay(args):
    policy = checked_policy(args.policy)
    capture = Path(args.capture)
    passed = 0
    failed = 0
    max_work = 0
    rows = []
    for line_no, line in enumerate(capture.read_text().splitlines(), 1):
        if not line.strip():
            continue
        try:
            case = json.loads(line)
            actual = evaluate_policy(policy, case["request"])
            expected = case["decision"]
        except Exception as exc:
            rows.append({"line": line_no, "ok": False, "error": str(exc)})
            failed += 1
            continue
        ok = actual["decision"] == expected
        passed += int(ok)
        failed += int(not ok)
        max_work = max(max_work, actual.get("work", 0))
        rows.append({"id": case.get("id", f"line-{line_no}"), "expected": expected,
                     "actual": actual["decision"], "work": actual.get("work"), "ok": ok})
    result = {"passed": passed, "failed": failed, "max_work": max_work, "cases": rows}
    print(json.dumps(result, indent=2))
    raise SystemExit(0 if failed == 0 else 1)


def main():
    parser = argparse.ArgumentParser(description="Northstar EdgeShield policy lab")
    sub = parser.add_subparsers(dest="command", required=True)
    p = sub.add_parser("check", help="validate an EdgeShield v1 policy")
    p.add_argument("policy"); p.set_defaults(func=command_check)
    p = sub.add_parser("inspect", help="show the legacy interpretation of a request envelope")
    p.add_argument("request"); p.set_defaults(func=command_inspect)
    p = sub.add_parser("probe", help="evaluate a request through a policy and then the legacy model")
    p.add_argument("policy"); p.add_argument("request"); p.set_defaults(func=command_probe)
    p = sub.add_parser("replay", help="replay a JSONL capture")
    p.add_argument("policy"); p.add_argument("capture", nargs="?", default="/app/traffic/representative.jsonl"); p.set_defaults(func=command_replay)
    args = parser.parse_args()
    args.func(args)

if __name__ == "__main__":
    main()
