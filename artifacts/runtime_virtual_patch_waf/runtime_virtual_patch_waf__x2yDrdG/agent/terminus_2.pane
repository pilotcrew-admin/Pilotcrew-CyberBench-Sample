import json
import subprocess

test_cases = {
    'space': '  a/b  ',
    'pct': 'a%2fb',
    'pct2': 'a%252fb',
    'bs': 'a\\b',
    'nfkc': 'a\uff0fb'
}

for t_name, t_val in test_cases.items():
    req = {
        'method': 'POST',
        'target': '/v1/render',
        'headers': [['Content-Type', 'multipart/form-data; boundary=B']],
        'body': f'--B\r\nContent-Disposition: form-data; name="template_locator"\r\n\r\n{t_val}\r\n--B--\r\n'
    }
    with open('/tmp/test_mp.json', 'w') as f:
        json.dump(req, f)
    out = subprocess.check_output(['/app/waflab', 'inspect', '/tmp/test_mp.json'])
    out_data = json.loads(out)
    locs = out_data.get('locators', [])
    if locs:
        print(f"multipart {t_name}: {locs[0]['normalized']}")
