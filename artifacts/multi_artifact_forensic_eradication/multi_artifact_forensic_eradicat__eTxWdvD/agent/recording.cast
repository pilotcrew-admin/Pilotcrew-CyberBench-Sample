[122.868694, "i", "cat << 'EOF' > remediate.sh\n#!/bin/bash\n# Quarantine files\nirctl quarantine acct-ws-04 FILE-27\nirctl quarantine backup-gw-02 FILE-914\nirctl quarantine vault-prx-03 FILE-931\n\n# Disable startup\nirctl disable-startup acct-ws-04 HKCU-17\nirctl disable-startup backup-gw-02 UNIT-77\nirctl disable-startup vault-prx-03 UNIT-93\n\n# Remove keys\nirctl remove-key backup-gw-02 KEY-88\nirctl remove-key vault-prx-03 KEY-94\n\n# Revoke sessions\nirctl revoke-session S-4101\nirctl revoke-session S-4302\n\n# Rotate credentials\nirctl rotate-credential 'CORP\\backupsvc'\nirctl rotate-credential 'CORP\\vaultsync'\n\n# Rebind services\nirctl rebind-service nightly-backup 'CORP\\backupsvc'\nirctl rebind-service archive-transfer 'CORP\\vaultsync'\n\n# Block indicators\n# IPs\nirctl block 198.51.100.77\nirctl block 203.0.113.201\nirctl block 198.51.100.203\n# Hashes\nirctl block 27c1b956a376f025da54daeae5b3f9b9d12af076646712a31f4963ee3f743b73\nirctl block 74f740bc25ef325f87c3d1db53c6f8bee500f7d5270e15857df24ac7a5b86e82\nirctl block 5a1ab623fda7df3cda48fc2d29a914c17ae700b3ceb79589d18bbd111b7f402d\n# Key Fingerprints\nirctl block 'SHA256:Q7aP1Wz4kD9nY2cLm8oRf6vH3sJ5uX0eBqTtN4iKp6M'\nirctl block 'SHA256:Zx4Kp9Vm2Qa7Nf6Rt1Yw8Hs3Lc5Db0GeUj4Mi7Po2As'\n\n# Start services\nirctl start-service acct-ws-04 ledger-client\nirctl start-service backup-gw-02 nightly-backup\nirctl start-service vault-prx-03 archive-transfer\n\nirctl verify\nEOF\n"]
[122.869029, "o", "cat << 'EOF' > remediate.sh\r\n\u001b[?2004l\r"]
[122.869386, "o", "\u001b[?2004h> "]
