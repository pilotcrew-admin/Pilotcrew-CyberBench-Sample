[?2004h[01;32manalyst@a177d2a90adc[00m:[01;34m/app[00m$ cat << 'EOF' > /app/build_plan.py
[?2004l[?2004h> import json, hashlib, hmac
[?2004l[?2004h> base = '/opt/crypto-case/'
[?2004l[?2004h> def load(p): return json.load(open(base + p))
[?2004l[?2004h> def loadl(p): return [json.loads(x) for x in open(base + p)]
[?2004l[?2004h> 
[?2004l[?2004h> estate = load('case/estate.json')
[?2004l[?2004h> materials = load('case/materials.json')['materials']
[?2004l[?2004h> policy = load('case/policy-baseline.json')
[?2004l[?2004h> events = loadl('case/deployment-events.jsonl')
[?2004l[?2004h> 
[?2004l[?2004h> # Compromised and retire materials
[?2004l[?2004h> compromised = ['sign-release-rsa']
[?2004l[?2004h> retire = [m['id'] for m in materials if m.get('disposition') == 'retire_at_completion']
[?2004l[?2004h> 
[?2004l[?2004h> # Dependencies
[?2004l[?2004h> deps = []
[?2004l[?2004h> bound_subjects = {}
[?2004l[?2004h> for e in events:
[?2004l[?2004h>     if e['time'] <= estate['captured_at']:
[?2004l[?2004h>         if e['event'] == 'bind':
[?2004l[?2004h>             bound_subjects[e['subject']] = e['consumer']
[?2004l[?2004h>         elif e['event'] == 'unbind':
[?2004l[?2004h>             if e['subject'] in bound_subjects:
[?2004l[?2004h>                 del bound_subjects[e['subject']]
[?2004l[?2004h> 
[?2004l[?2004h> tls_obs = loadl('case/tls-negotiations.jsonl')
[?2004l[?2004h> sign_obs = loadl('case/signature-verifications.jsonl')
[?2004l[?2004h> ssh_obs = loadl('case/ssh-sessions.jsonl')
[?2004l[?2004h> 
[?2004l[?2004h> latest_obs = {}
[?2004l[?2004h> for obs in tls_obs + sign_obs + ssh_obs:
[?2004l[?2004h>     if obs.get('result') == 'success' and obs['observed_at'] <= estate['captured_at']:
[?2004l[?2004h>         subj = obs['subject']
[?2004l[?2004h>         if subj in bound_subjects:
[?2004l[?2004h>             if subj not in latest_obs or obs['observed_at'] > latest_obs[subj]['observed_at']:
[?2004l[?2004h>                 latest_obs[subj] = obs
[?2004l[?2004h> 
[?2004l[?2004h> consumer_deps = {}
[?2004l[?2004h> for subj, obs in latest_obs.items():
[?2004l[?2004h>     cons = bound_subjects[subj]
[?2004l[?2004h>     if cons not in consumer_deps:
[?2004l[?2004h>         consumer_deps[cons] = {'surface': obs['surface'], 'consumer': cons, 'effective_algorithms': set(), 'materials': set(), 'evidence': set()}
[?2004l[?2004h>     consumer_deps[cons]['effective_algorithms'].update(obs['algorithms'])
[?2004l[?2004h>     consumer_deps[cons]['materials'].update(obs.get('materials', []))
[?2004l[?2004h>     consumer_deps[cons]['evidence'].add(obs['id'])
[?2004l[?2004h> 
[?2004l[?2004h> for v in consumer_deps.values():
[?2004l[?2004h>     deps.append({
[?2004l[?2004h>         'surface': v['surface'],
[?2004l[?2004h>         'consumer': v['consumer'],
[?2004l[?2004h>         'effective_algorithms': sorted(list(v['effective_algorithms'])),
[?2004l[?2004h>         'materials': sorted(list(v['materials'])),
[?2004l[?2004h>         'evidence': sorted(list(v['evidence']))
[?2004l[?2004h>     })
[?2004l[?2004h> 
[?2004l[?2004h> archives = load('case/archives.json')['archives']
[?2004l[?2004h> for a in archives:
[?2004l[?2004h>     deps.append({
[?2004l[?2004h>         'surface': a['surface'],
[?2004l[?2004h>         'consumer': a['id'],
[?2004l[?2004h>         'effective_algorithms': sorted([a['data_cipher'], a['wrap_algorithm']]),
[?2004l[?2004h>         'materials': [a['wrap_material']],
[?2004l[?2004h>         'evidence': [a['evidence']]
[?2004l[?2004h>     })
[?2004l[?2004h> 
[?2004l[?2004h> final_policies = {
[?2004l[?2004h>     'tls:telemetry-api': {
[?2004l[?2004h>         'minimum_protocol': policy['surfaces']['tls:telemetry-api']['minimum_protocol'],
[?2004l[?2004h>         'allowed_kex': policy['surfaces']['tls:telemetry-api']['required_kex'],
[?2004l[?2004h>         'allowed_server_credentials': ['tls-api-2027'],
[?2004l[?2004h>         'trusted_roots': ['tls-root-2027'],
[?2004l[?2004h>         'reject_downgrade': policy['surfaces']['tls:telemetry-api']['reject_downgrade']
[?2004l[?2004h>     },
[?2004l[?2004h>     'signing:device-update': {
[?2004l[?2004h>         'required_signers': ['sign-release-ed', 'sign-release-pq'],
