[?2004l[?2004h>     # new_envelope = HMAC-SHA256(key=HEX(material.rewrap_share_hex), message=message)
[?2004l[?2004h>     # restore_proof = HMAC-SHA256(key=HEX(new_envelope), message=UTF8("restore-v1") || NUL || context)
[?2004l[?2004h>     fix = next(f for f in fixtures['archive_objects'] if f['archive'] == a['id'])
