[?2004l[?2004h>     proof = hmac.new(bytes.fromhex(new_env), utf8('restore-v1') + b_nul() + ctx, hashlib.sha256).hexdigest()
[?2004l[?2004h>     
[?2004l[?2004h>     add_action({'action': 'migrate_archive', 'archive': a['id'], 'mode': a['migration_mode'],
