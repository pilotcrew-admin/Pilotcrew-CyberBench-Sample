[?2004l[?2004h>     'archive-recovery': ('upgrade-restore-2.0', 'restore-2.0')
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> packages = {p['id']: p for p in compat['packages']}
[?2004l[?2004h> consumers = {c['id']: c for c in estate['consumers']}
[?2004l[?2004h> state_seeds = {u['consumer']: u['state_seed_hex'] for u in fixtures['upgrade_states']}
[?2004l[?2004h> 
[?2004l[?2004h> def utf8(s): return s.encode('utf-8')
[?2004l[?2004h> def b_nul(): return b'\x00'
[?2004l[?2004h> 
[?2004l[?2004h> def diag_state(st, cons_allow_reimage):
[?2004l[?2004h>     w = st.get('write_phase')
[?2004l[?2004h>     j = st.get('journal_integrity')
[?2004l[?2004h>     n = st.get('new_image_integrity')
[?2004l[?2004h>     r = st.get('resume_token')
[?2004l[?2004h>     b = st.get('rollback_snapshot')
[?2004l[?2004h>     i = st.get('image_cache')
[?2004l[?2004h>     if w == 'not_started': return 'retry_same_image'
[?2004l[?2004h>     if w == 'complete_uncommitted' and j == 'valid' and n == 'verified' and r == 'valid': return 'resume_commit'
[?2004l[?2004h>     if b == 'verified': return 'rollback_then_retry'
[?2004l[?2004h>     if i == 'verified' and cons_allow_reimage: return 'reimage_then_retry'
[?2004l[?2004h>     return None
[?2004l[?2004h> 
[?2004l[?2004h> for cons_id, (pkg_id, target_ver) in upgrades.items():
[?2004l[?2004h>     pkg = packages[pkg_id]
[?2004l[?2004h>     cons = consumers[cons_id]
[?2004l[?2004h>     
[?2004l[?2004h>     for ring in ['canary', 'fleet']:
[?2004l[?2004h>         batch = {'max_per_failure_domain': cons['rollout']['canary_max_per_failure_domain'] if ring == 'canary' else cons['availability']['max_per_failure_domain'],
[?2004l[?2004h>                  'max_total': cons['rollout']['canary_max_per_failure_domain'] * len(cons['rollout']['failure_domains']) if ring == 'canary' else cons['availability']['max_total_offline']}
[?2004l[?2004h>         
[?2004l[?2004h>         add_action({'action': 'upgrade_consumer', 'consumer': cons_id, 'ring': ring, 'package': pkg_id, 'batch': batch, 'on_interrupt': cons['rollout']['on_interrupt']})
[?2004l[?2004h>         
[?2004l[?2004h>         # Upgrade gate and receipts
[?2004l[?2004h>         seed = state_seeds[cons_id]
[?2004l[?2004h>         ctx = utf8(cons_id) + b_nul() + utf8(ring) + b_nul() + utf8(pkg_id) + b_nul() + utf8(target_ver) + b_nul() + utf8(pkg['image_digest'])
[?2004l[?2004h>         base_key = hashlib.sha256(bytes.fromhex(seed) + ctx).digest()
[?2004l[?2004h>         
[?2004l[?2004h>         if ring == 'canary': parent = hashlib.sha256(utf8('captured-v2') + b_nul() + bytes.fromhex(seed)).hexdigest()
[?2004l[?2004h>         else: parent = canary_parent
[?2004l[?2004h>         
[?2004l[?2004h>         steps = []
[?2004l[?2004h>         for fp in fixtures['fault_points']:
[?2004l[?2004h>             # find observation
[?2004l[?2004h>             cands = [o for o in interruptions if o['consumer'] == cons_id and o['ring'] == ring and o['package'] == pkg_id and o['fault_point'] == fp and o['result'] == 'captured' and o['observed_at'] <= fixtures['interruption_capture_cutoff']]
[?2004l[?2004h>             if not cands: continue
[?2004l[?2004h>             sel = sorted(cands, key=lambda x: (x['observed_at'], x['id']))[-1]
[?2004l[?2004h>             
[?2004l[?2004h>             dec = diag_state(sel['state'], cons.get('rollout', {}).get('reimage_allowed', False))
[?2004l[?2004h>             work = fixtures['recovery_action_work_units'][dec]
[?2004l[?2004h>             
[?2004l[?2004h>             msg = utf8('recover-v2') + b_nul() + bytes.fromhex(parent) + b_nul() + utf8(fp) + b_nul() + utf8(sel['id']) + b_nul() + bytes.fromhex(sel['state_digest']) + b_nul() + utf8(dec) + b_nul() + utf8(str(work))
[?2004l[?2004h>             r = hmac.new(base_key, msg, hashlib.sha256).hexdigest()
[?2004l[?2004h>             parent = r
[?2004l[?2004h>             steps.append({'fault_point': fp, 'evidence': sel['id'], 'decision': dec, 'work_units': work, 'receipt': r})
[?2004l[?2004h>         
[?2004l[?2004h>         add_action({'action': 'upgrade_gate', 'consumer': cons_id, 'ring': ring, 'package': pkg_id, 'recovery_steps': steps})
[?2004l[?2004h>         if ring == 'canary': canary_parent = parent
