[?2004l[?2004h> })
[?2004l[?2004h> 
[?2004l[?2004h> # Workflow gates
[?2004l[?2004h> for ring in ['canary', 'fleet']:
[?2004l[?2004h>     add_action({'action': 'workflow_gate', 'surface': 'tls:telemetry-api', 'ring': ring, 'profile': 'target'})
[?2004l[?2004h>     add_action({'action': 'workflow_gate', 'surface': 'signing:device-update', 'ring': ring, 'profile': 'target'})
