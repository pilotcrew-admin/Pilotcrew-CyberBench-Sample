[?2004l[?2004h>                 'wrap_material': 'archive-wrap-hybrid-c',
[?2004l[?2004h>                 'new_envelope_hex': new_env, 'restore_proof': proof})
[?2004l[?2004h> 
[?2004l[?2004h> add_action({'action': 'archive_gate', 'consumers': ['archive-recovery', 'archive-audit'], 'digests': [a['digest'] for a in archives]})
[?2004l[?2004h> 
