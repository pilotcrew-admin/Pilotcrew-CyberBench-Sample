[?2004l[?2004h> 
[?2004l[?2004h> # 1. Findings
[?2004l[?2004h> compromised = [e['material'] for e in incidents['events'] if e['confidence'] == 'confirmed' and e['type'] in ('hsm_export_confirmed',)]
[?2004l[?2004h> retire = [m['id'] for m in materials if m.get('lifecycle', {}).get('disposition') == 'retire_at_completion']
[?2004l[?2004h> 
[?2004l[?2004h> # 2. Dependencies
[?2004l[?2004h> bindings = {}
[?2004l[?2004h> for ev in sorted(events, key=lambda x: x['time']): 
[?2004l[?2004h>     if ev['time'] > captured_at: break
[?2004l[?2004h>     c, s = ev['consumer'], ev['subject']
[?2004l[?2004h>     if ev['event'] == 'bind':
[?2004l[?2004h>         bindings.setdefault(c, set()).add(s)
[?2004l[?2004h>     elif ev['event'] == 'unbind':
[?2004l[?2004h>         if c in bindings and s in bindings[c]:
[?2004l[?2004h>             bindings[c].remove(s)
[?2004l[?2004h> 
[?2004l[?2004h> req_consumers = {c['id']: c for c in estate['consumers'] if c['required']}
[?2004l[?2004h> 
[?2004l[?2004h> obs = load_jsonl('tls-negotiations.jsonl') + load_jsonl('signature-verifications.jsonl') + load_jsonl('ssh-sessions.jsonl')
[?2004l[?2004h> obs = [o for o in obs if o.get('observed_at', '') <= captured_at and o.get('result') == 'success']
[?2004l[?2004h> obs.sort(key=lambda x: x['observed_at'], reverse=True)
[?2004l[?2004h> 
[?2004l[?2004h> deps = []
[?2004l[?2004h> for c_id, c in req_consumers.items():
[?2004l[?2004h>     if c['surface'].startswith('archive'): continue
[?2004l[?2004h>     active_subjects = bindings.get(c_id, set())
[?2004l[?2004h>     c_obs = []
[?2004l[?2004h>     for s in active_subjects:
[?2004l[?2004h>         for o in obs:
[?2004l[?2004h>             if o['subject'] == s:
[?2004l[?2004h>                 c_obs.append(o)
[?2004l[?2004h>                 break
[?2004l[?2004h>     if c_obs:
[?2004l[?2004h>         eff_alg = set()
[?2004l[?2004h>         eff_mat = set()
[?2004l[?2004h>         ev_ids = set()
[?2004l[?2004h>         for o in c_obs:
[?2004l[?2004h>             eff_alg.update(o.get('algorithms', []))
[?2004l[?2004h>             eff_mat.update(o.get('materials', []))
[?2004l[?2004h>             ev_ids.add(o['id'])
[?2004l[?2004h>         deps.append({
[?2004l[?2004h>             'surface': c['surface'],
[?2004l[?2004h>             'consumer': c_id,
[?2004l[?2004h>             'effective_algorithms': sorted(list(eff_alg)),
[?2004l[?2004h>             'materials': sorted(list(eff_mat)),
[?2004l[?2004h>             'evidence': sorted(list(ev_ids))
[?2004l[?2004h>         })
[?2004l[?2004h> 
[?2004l[?2004h> for a in archives:
[?2004l[?2004h>     deps.append({
[?2004l[?2004h>         'surface': 'archive:compliance',
[?2004l[?2004h>         'consumer': a['id'],
[?2004l[?2004h>         'effective_algorithms': sorted([a['data_cipher'], a['wrap_algorithm']]),
[?2004l[?2004h>         'materials': sorted([a['wrap_material']]),
[?2004l[?2004h>         'evidence': sorted([a['evidence']])
[?2004l[?2004h>     })
[?2004l[?2004h> 
