nsumers\']:\n    if not c.get(\'required\') or c[\'surface\'].startswith(\'archive:\'): continue\n    subs = active_subjects.get(c[\'id\'], set())\n    c_algs = set(); c_mats = set(); c_ev = set()\n    for s in subs:\n        for o in valid_obs:\n            if o[\'surface\'] == c[\'surface\'] and o[\'subject\'] == s:\n                c_algs.update(o[\'algorithms\']); c_mats.update(o.get(\'materials\', [])); c_ev.add(o[\'id\'])\n                break\n    if c_ev: deps.append({\'surface\': c[\'surface\'], \'consumer\': c[\'id\'], \'effective_algorithms\': sorted(list(c_algs)), \'materials\': sorted(list(c_mats)), \'evidence\': sorted(list(c_ev))})\n\nfor arc in archives_data:\n    deps.append({\'surface\': arc[\'surface\'], \'consumer\': arc[\'id\'], \'effective_algorithms\': sorted([arc[\'data_cipher\'], arc[\'wrap_algorithm\']]), \'materials\': [arc[\'wrap_material\']], \'evidence\': [arc[\'evidence\']]})\n\ncomp_mats = {inc[\'material\'] for inc in incidents.get(\'events\', []) if inc.get(\'confidence\') == \'confirmed\' and inc.get(\'type\') in [\'material_export\', \'unauthorized_signing_session\']}\nretire_mats = {m[\'id\'] for m in materials_data if m.get(\'disposition\') == \'retire_at_completion\'}\nfindings = {\'compromised_material\': sorted(list(comp_mats)), \'retire_material\': sorted(list(retire_mats))}\nfinal_policies = base_policy.get(\'surfaces\', {})\n\nactions = []\nact_idx = 1\ndef add_act(a): global act_idx; a[\'id\'] = f"act-{act_idx}"; act_idx += 1; actions.append(a)\n\nfor c in findings[\'compromised_material\']: add_act({\'op\': \'contain_signer\', \'material\': c})\n\n# Staging materials (selecting vault-a, vault-b, public limits)\nstaged_mats = [\'tls-root-2027\', \'tls-api-2027\', \'sign-release-ed\', \'sign-release-pq-c\', \'ssh-host-ed25519-c\', \'ssh-user-ca-ed\', \'archive-wrap-hybrid\']\nfor m in staged_mats: add_act({\'op\': \'stage_material\', \'material\': m})\n\ntransition_cfg = {\n    \'tls:telemetry-api\': [\'tls-api-2024\', \'tls-api-2027\'],\n    \'signing:device-update\': [\'sign-release-ed\', \'sign-release-pq-c\'],\n    \'ssh:ops-bastion\': [\'ssh-host-rsa1024\', \'ssh-user-ca-rsa\', \'ssh-host-ed25519-c\', \'ssh-user-ca-ed\']\n}\n\n# Upgrade targets\nupgrades = {\n    \'tls-field-north\': \'upgrade-gw-north-6.2\', \'tls-field-south\': \'upgrade-gw-5.4\',\n    \'tls-batch-export\': \'upgrade-export-3.0\', \'sign-plant-alpha\': \'upgrade-boot-v3\',\n    \'sign-plant-beta\': \'upgrade-boot-v3\', \'ssh-oncall\': \'upgrade-ssh-9.6\',\n    \'ssh-automation\': None, # ssh-9.3 already ok?\n    \'archive-recovery\': \'upgrade-restore-2.0\', \'archive-audit\': \'upgrade-restore-2.0\'\n}\n\n# Re-check ssh-automation. version is ssh-9.3. \n# Target is SSH_ED25519 for both host and ca. We might need ssh-9.6. \n# Actually 9.3 supports it, so let\'s check rehearsal. If it complains we will fix it.\n\ndef get_pkg(pid):\n    for p in compat[\'packages\']: \n        if p[\'id\'] == pid: return p\n    return None\n\ncutoff = fixtures[\'interruption_capture_cutoff\']\nobs_valid = [o for o in obs_raw if o[\'result\'] == \'captured\' and o[\'observed_at\'] <= cutoff]\nobs_valid.sort(key=lambda x: (x[\'observed_at\'], x[\'id\']), reverse=True)\n\ndef diagnose(st, permits_reimage):\n    wp = st.get(\'write_phase\'); ji = st.get(\'journal_integrity\'); ni = st.get(\'new_image_integrity\')\n    rt = st.get(\'resume_token\'); rs = st.get(\'rollback_snapshot\'); ic = st.get(\'image_cache\')\n    if wp == \'not_started\': return \'retry_same_image\'\n    if wp == \'complete_uncommitted\' and ji == \'valid\' and ni == \'verified\' and rt == \'valid\': return \'resume_commit\'\n    if rs == \'verified\': return \'rollback_then_retry\'\n    if ic == \'verified\' and permits_reimage: return \'reimage_then_retry\'\n    return None\n\ncanary_receipts = {}\nfor ring in [\'canary\', \'fleet\']:\n    for cons in estate[\'consumers\']:\n        cid = cons[\'id\']\n        pid = upgrades.get(cid)\n        if not pid: continue\n        pkg = get_pkg(pid)\n        fd = cons[\'rollout\'][\'failure_domains\']\n        if ring == \'canary\': \n            max_pd = cons[\'rollout\'][\'canary_max_per_failure_domain\']\n            batch = {\'max_total\': max_pd * len(fd), \'max_per_failure_domain\': max_pd}\n        else:\n            batch = {\'max_total\': cons[\'availability\'][\'max_total_offline\'], \'max_per_failure_domain\': cons[\'availability\'][\'max_per_failure_domain\']}\n        \n        add_act({\'op\': \'upgrade_consumer\', \'consumer\': cid, \'package\': pid, \'ring\': ring, \'failure_domains\': fd, \'batch\': batch, \'on_interrupt\': cons[\'rollout\'][\'on_interrupt\']})\n        \n        # Gate\n        seed = next(s[\'state_seed_hex\'] for s in fixtures[\'upgrade_states\'] if s[\'consumer\'] == cid)\n        base_ctx = f"{cid}\\x00{ring}\\x00{pid}\\x00{pkg[\'to_version\']}\\x00{pkg[\'image_digest\']}".encode(\'utf-8\')\n        base_key = sha256_b(bytes.fromhex(seed) + base_ctx)\n        if ring == \'canary\':\n            parent = sha256_b(b"captured-v2\\x00" + bytes.fromhex(seed))\n        else:\n            parent = canary_receipts[cid]\n            \n        steps = []\n        for fp in fixtures[\'fault_points\']:\n            ob = next((o for o in obs_valid if o[\'consumer\'] == cid and o[\'ring\'] == ring and o[\'package\'] == pid and o[\'fault_point\'] == fp), None)\n            if not ob: continue\n            state_str = json.dumps(ob[\'state\'], sort_keys=True, separators=(",", ":"))\n            s_digest = sha256_b(state_str.encode(\'utf-8\'))\n            dec = diagnose(ob[\'state\'], cons[\'rollout\'].get(\'reimage_allowed\', False))\n            if not dec: continue\n            wu = fixtures[\'recovery_action_work_units\'][dec]\n            msg = f"recover-v2\\x00{parent}\\x00{fp}\\x00{ob[\'id\']}\\x00{s_digest}\\x00{dec}\\x00{wu}".encode(\'utf-8\')\n            receipt = hmac256_b(bytes.fromhex(base_key), msg)\n            parent = receipt\n            steps.append({\'fault_point\': fp, \'evidence\': ob[\'id\'], \'decision\': dec, \'work_units\': wu, \'receipt\': receipt})\n        \n        if ring == \'canary\': canary_receipts[cid] = parent\n        add_act({\'op\': \'upgrade_gate\', \'consumer\': cid, \'ring\': ring, \'package\': pid, \'expected_version\': pkg[\'to_version\'], \'recovery_steps\': steps})\n\n    # Distribute trust & configure transition for canary\n    for cons in estate[\'consumers\']:\n        cid = cons[\'id\']; sur = cons[\'surface\']\n        if sur == \'tls:telemetry-api\': \n            add_act({\'op\': \'distribute_trust\', \'consumer\': cid, \'ring\': ring, \'material\': \'tls-root-2027\'})\n            if cid == \'tls-field-north\': add_act({\'op\': \'activate_material\', \'surface\': sur, \'material\': \'tls-api-2027\'})\n        elif sur == \'signing:device-update\':\n            add_act({\'op\': \'distribute_trust\', \'consumer\': cid, \'ring\': ring, \'material\': \'sign-release-ed\'})\n            add_act({\'op\': \'distribute_trust\', \'consumer\': cid, \'ring\': ring, \'material\': \'sign-release-pq-c\'})\n        elif sur == \'ssh:ops-bastion\':\n            add_act({\'op\': \'distribute_trust\', \'consumer\': cid, \'ring\': ring, \'material\': \'ssh-host-ed25519-c\'})\n    \n    if ring == \'canary\':\n        for sur, mats in transition_cfg.items():\n            add_act({\'op\': \'configure_transition\', \'surface\': sur, \'allowed_materials\': mats})\n            \n    for cons in estate[\'consumers\']:\n        if cons[\'surface\'].startswith(\'archive:\'): continue\n        add_act({\'op\': \'workflow_gate\', \'surface\': cons[\'surface\'], \'consumer\': cons[\'id\'], \'ring\': ring, \'profile\': \'target\'})\n\n# Archives\nadd_act({\'op\': \'activate_material\', \'surface\': \'archive:compliance\', \'material\': \'archive-wrap-hybrid\'})\nfor arc in archives_data:\n    aid = arc[\'id\']\n    obj = next(o for o in fixtures[\'archive_objects\'] if o[\'archive\'] == aid)\n    mat = next(m for m in materials_data if m[\'id\'] == \'archive-wrap-hybrid\')\n    ctx = f"{aid}\\x00{final_policies[\'archive:compliance\'][\'data_cipher\']}\\x00archive-wrap-hybrid\\x00{arc[\'digest\']}".encode(\'utf-8\')\n    msg = bytes.fromhex(obj[\'legacy_envelope_hex\']) + bytes.fromhex(obj[\'object_nonce_hex\']) + ctx\n    nenv = hmac256_hex(mat[\'rewrap_share_hex\'], msg)\n    proof = hmac256_hex(nenv, b"restore-v1\\x00" + ctx)\n    add_act({\'op\': \'migrate_archive\', \'archive\': aid, \'data_cipher\': final_policies[\'archive:compliance\'][\'data_cipher\'], \'wrap_material\': \'archive-wrap-hybrid\', \'mode\': arc[\'migration_mode\'], \'new_envelope_hex\': nenv, \'restore_proof\': proof})\n    add_act({\'op\': \'archive_gate\', \'archive\': aid, \'consumers\': arc[\'required_consumers\'], \'expected_digest\': arc[\'digest\']})\n\nfor sur in final_policies:\n    add_act({\'op\': \'set_final_policy\', \'surface\': sur})\nfor r in findings[\'retire_material\']:\n    add_act({\'op\': \'retire_material\', \'material\': r})\n\nplan = {\'format_version\': 1, \'case_id\': estate[\'case_id\'], \'findings\': findings, \'dependencies\': deps, \'final_policies\': final_policies, \'actions\': actions}\nwith open(\'/app/submission/migration-plan.json\', \'w\') as f: json.dump(plan, f, indent=2)\nEOF\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
