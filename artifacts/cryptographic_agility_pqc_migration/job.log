\n        'effective_algorithms': sorted(list(v['effective_algorithms'])),\n        'materials': sorted(list(v['materials'])),\n        'evidence': sorted(list(v['evidence']))\n    })\n\narchives = load('case/archives.json')['archives']\nfor a in archives:\n    deps.append({\n        'surface': a['surface'],\n        'consumer': a['id'],\n        'effective_algorithms': sorted([a['data_cipher'], a['wrap_algorithm']]),\n        'materials': [a['wrap_material']],\n        'evidence': [a['evidence']]\n    })\n\nfinal_policies = {\n    'tls:telemetry-api': {\n        'minimum_protocol': policy['surfaces']['tls:telemetry-api']['minimum_protocol'],\n        'allowed_kex': policy['surfaces']['tls:telemetry-api']['required_kex'],\n        'allowed_server_credentials': ['tls-api-2027'],\n        'trusted_roots': ['tls-root-2027'],\n        'reject_downgrade': policy['surfaces']['tls:telemetry-api']['reject_downgrade']\n    },\n    'signing:device-update': {\n        'required_signers': ['sign-release-ed', 'sign-release-pq'],\n        'allowed_algorithms': policy['surfaces']['signing:device-update']['allowed_signature_algorithms'],\n        'threshold': policy['surfaces']['signing:device-update']['threshold'],\n        'context': policy['surfaces']['signing:device-update']['signing_context'],\n        'reject_revoked': policy['surfaces']['signing:device-update']['reject_revoked']\n    },\n    'ssh:ops-bastion': {\n        'allowed_host_algorithms': policy['surfaces']['ssh:ops-bastion']['allowed_host_key_algorithms'],\n        'allowed_user_ca_algorithms': policy['surfaces']['ssh:ops-bastion']['allowed_user_ca_algorithms'],\n        'allowed_host_keys': ['ssh-host-ed25519-c'],\n        'trusted_user_cas': ['ssh-user-ca-ed'],\n        'reject_sha1': policy['surfaces']['ssh:ops-bastion']['reject_sha1'],\n        'strict_host_identity': policy['surfaces']['ssh:ops-bastion']['strict_host_identity']\n    },\n    'archive:compliance': {\n        'data_cipher': policy['surfaces']['archive:compliance']['data_cipher'],\n        'wrap_algorithm': policy['surfaces']['archive:compliance']['wrap_algorithm'],\n        'allowed_wrapping_keys': ['archive-wrap-hybrid-c'],\n        'require_aead': policy['surfaces']['archive:compliance']['require_aead'],\n        'require_hybrid_wrap': policy['surfaces']['archive:compliance']['require_hybrid_wrap']\n    }\n}\n\n# Output intermediate to check\nopen('/app/submission/migration-plan.json', 'w').write(json.dumps({\n    'format_version': 1,\n    'case_id': estate['case_id'],\n    'findings': {'compromised_material': compromised, 'retire_material': sorted(retire)},\n    'dependencies': deps,\n    'final_policies': final_policies,\n    'actions': []\n}, indent=2))\nEOF\npython3 /app/build_plan.py\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
