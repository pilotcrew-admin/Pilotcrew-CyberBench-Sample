ive',\n        'archive': a_id,\n        'data_cipher': 'AES_256_GCM',\n        'wrap_material': 'archive-wrap-hybrid',\n        'mode': mode,\n        'new_envelope_hex': new_env,\n        'restore_proof': proof\n    })\n    \n    req_restore = [c['id'] for c in estate['consumers'] if c['surface'] == 'archive:compliance' and c['required']]\n    actions.append({\n        'id': f'agate-{a_id}',\n        'op': 'archive_gate',\n        'archive': a_id,\n        'consumers': req_restore,\n        'expected_digest': a['plaintext_digest']\n    })\n\n# Set final policies\nfor surf in baseline['surfaces']:\n    actions.append({\n        'id': f'pol-{surf}',\n        'op': 'set_final_policy',\n        'surface': surf\n    })\n\n# Retire\nfor m in old_materials:\n    actions.append({\n        'id': f'retire-{m}',\n        'op': 'retire_material',\n        'material': m\n    })\n\nplan = {\n    'format_version': 1,\n    'case_id': estate['case_id'],\n    'findings': findings,\n    'dependencies': dependencies,\n    'final_policies': final_policies,\n    'actions': actions\n}\n\nos.makedirs('/app/submission', exist_ok=True)\nwith open('/app/submission/migration-plan.json', 'w') as f:\n    json.dump(plan, f, indent=2)\nEOF\n"] min_timeout_sec: 0.2 max_timeout_sec: 180.0
