Sending keys: ["cat << 'EOF' > parse_deps.py\nimport json\n\ndef load_json(p): \n    with open(p) as f: return json.load(f)\ndef load_jsonl(p):\n    with open(p) as f: return [json.loads(l) for l in f if l.strip()]\n\nestate = load_json('/opt/crypto-case/case/estate.json')\ncaptured_at = estate['captured_at']\n\nevents = load_jsonl('/opt/crypto-case/case/deployment-events.jsonl')\nevents.sort(key=lambda x: x['time'])\n\nactive_subjects = {}\nfor ev in events:\n    if ev['time'] > captured_at: continue\n    subj = ev['subject']\n    cons = ev['consumer']\n    if ev['event'] == 'bind':\n        active_subjects.setdefault(cons, set()).add(subj)\n    elif ev['event'] == 'unbind':\n        if cons in active_subjects and subj in active_subjects[cons]:\n            active_subjects[cons].remove(subj)\n\nobs = []\nobs.extend(load_jsonl('/opt/crypto-case/case/tls-negotiations.jsonl'))\nobs.extend(load_jsonl('/opt/crypto-case/case/signature-verifications.jsonl'))\nobs.extend(load_jsonl('/opt/crypto-case/case/ssh-sessions.jsonl'))\n\nvalid_obs = [o for o in obs if o['result'] == 'success' and o['observed_at'] <= captured_at]\nvalid_obs.sort(key=lambda x: x['observed_at'], reverse=True)\n\ndeps = []\nfor cons_info in estate['consumers']:\n    cons_id = cons_info['id']\n    surface = cons_info['surface']\n    if not cons_info.get('required'): continue\n    if surface.startswith('archive:'): continue\n    \n    subjects = active_subjects.get(cons_id, set())\n    cons_algs = set()\n    cons_mats = set()\n    cons_ev = set()\n    \n    for subj in subjects:\n        for o in valid_obs:\n            if o['surface'] == surface and o['subject'] == subj:\n                cons_algs.update(o['algorithms'])\n                cons_mats.update(o.get('materials', []))\n                cons_ev.add(o['id'])\n                break\n                \n    if cons_ev:\n        deps.append({\n            'surface': surface,\n            'consumer': cons_id,\n            'effective_algorithms': sorted(list(cons_algs)),\n            'materials': sorted(list(cons_mats)),\n            'evidence': sorted(list(cons_ev))\n        })\n\narchives = load_json('/opt/crypto-case/case/archives.json')\nfor arc in archives.get('archives', []):\n    deps.append({\n        'surface': arc['surface'],\n        'consumer': arc['id'],\n        'effective_algorithms': sorted([arc['data_cipher'], arc['wrap_algorithm']]),\n        'materials': [arc['wrap_material']],\n        'evidence': [arc['evidence']]\n    })\n\nincidents = load_json('/opt/crypto-case/case/incident-evidence.json')\ncompromised = set()\nfor inc in incidents.get('events', []):\n    if inc.get('confidence') == 'confirmed':\n        compromised.add(inc['material'])\n\nmaterials = load_json('/opt/crypto-case/case/materials.json')\nretire = set()\nfor mat_id, mat in materials.items():\n    if mat.get('disposition') == 'retire_at_completion':\n        retire.add(mat_id)\n\nout = {\n    'findings': {\n        'compromised_material': sorted(list(compromised)),\n        'retire_material': sorted(list(retire))\n    },\n    'dependencies': deps\n}\nprint(json.dumps(out, indent=2))\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
