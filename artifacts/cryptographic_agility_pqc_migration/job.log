-2.0', 'restore-2.0')\n}\n\n# Precompute packages for digests\npackages = {p['id']: p for p in load('compatibility.json')['packages']}\n\ncutoff = fixtures['interruption_capture_cutoff']\nwork_units = fixtures['recovery_action_work_units']\n\ndef compact_json(obj):\n    return json.dumps(obj, sort_keys=True, separators=(',', ':'))\n\ndef compute_receipt(base_key, parent_hex, fault_point, ev_id, state_digest, decision, work):\n    msg = b'recover-v2\\x00' + parent_hex.encode() + b'\\x00' + fault_point.encode() + b'\\x00' + ev_id.encode() + b'\\x00' + state_digest.encode() + b'\\x00' + decision.encode() + b'\\x00' + str(work).encode()\n    return hmac.new(base_key, msg, hashlib.sha256).hexdigest()\n\nupgraded_consumers = []\n\nfor ring in ['canary', 'fleet']:\n    for c_id, (pkg_id, expected_version) in upgrades_needed.items():\n        c = consumers[c_id]\n        pkg = packages[pkg_id]\n        image_digest = pkg['image_digest']\n        \n        # Action: upgrade_consumer\n        a_upg = {\n            'id': f'upgrade-{c_id}-{ring}',\n            'op': 'upgrade_consumer',\n            'consumer': c_id,\n            'package': pkg_id,\n            'ring': ring,\n            'failure_domains': c['rollout']['failure_domains'] if ring == 'fleet' else [c['rollout']['failure_domains'][0]],\n            'batch': {'max_total': 1, 'max_per_failure_domain': 1}, # simple batch limits\n            'on_interrupt': c['rollout']['on_interrupt']\n        }\n        if ring == 'fleet':\n            a_upg['batch'] = {\n                'max_total': c['availability']['max_total_offline'],\n                'max_per_failure_domain': c['availability']['max_per_failure_domain']\n            }\n        actions.append(a_upg)\n        \n        # Prepare base key\n        state_seed_hex = fixtures['upgrade_states'][c_id][ring]\n        base_context = c_id.encode() + b'\\x00' + ring.encode() + b'\\x00' + pkg_id.encode() + b'\\x00' + expected_version.encode() + b'\\x00' + image_digest.encode