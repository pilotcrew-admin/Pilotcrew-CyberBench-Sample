[?2004l[?2004h> import json, hmac, hashlib
[?2004l[?2004h> from datetime import datetime
[?2004l[?2004h> 
[?2004l[?2004h> base = '/opt/crypto-case'
[?2004l[?2004h> def load_json(n):
[?2004l[?2004h>     with open(f'{base}/{n}') as f: return json.load(f)
[?2004l[?2004h> def load_jsonl(n):
[?2004l[?2004h>     with open(f'{base}/{n}') as f: return [json.loads(line) for line in f if line.strip()]
[?2004l[?2004h> 
[?2004l[?2004h> estate = load_json('case/estate.json')
[?2004l[?2004h> cutoff = estate['captured_at']
[?2004l[?2004h> incident = load_json('case/incident-evidence.json')
[?2004l[?2004h> materials = load_json('case/materials.json')['materials']
[?2004l[?2004h> baseline = load_json('case/policy-baseline.json')
[?2004l[?2004h> fixtures = load_json('case/execution-fixtures.json')
[?2004l[?2004h> archives = load_json('case/archives.json')['archives']
[?2004l[?2004h> comp = load_json('case/compatibility.json')
[?2004l[?2004h> interruption_obs = load_jsonl('case/interruption-observations.jsonl')
[?2004l[?2004h> 
[?2004l[?2004h> required_consumers = {c['id']: c for c in estate['consumers'] if c.get('required')}
[?2004l[?2004h> 
[?2004l[?2004h> # 1. Dependencies and Findings
[?2004l[?2004h> comp_mat = [ev['material'] for ev in incident['events'] if ev.get('confidence') == 'confirmed' and ev.get('type') in ['hsm_export_confirmed', 'unauthorized_signing']]
[?2004l[?2004h> retire_mat = sorted([m['id'] for m in materials if m.get('disposition') == 'retire_at_completion'])
[?2004l[?2004h> 
[?2004l[?2004h> events = load_jsonl('case/deployment-events.jsonl')
[?2004l[?2004h> events.sort(key=lambda x: x['time'])
[?2004l[?2004h> active_bindings = {}
[?2004l[?2004h> for ev in events:
[?2004l[?2004h>     if ev['time'] > cutoff: continue
[?2004l[?2004h>     c, s = ev['consumer'], ev['subject']
[?2004l[?2004h>     if ev['event'] == 'bind': active_bindings.setdefault(c, set()).add(s)
[?2004l[?2004h>     elif ev['event'] == 'unbind' and c in active_bindings and s in active_bindings[c]: active_bindings[c].remove(s)
[?2004l[?2004h> 
[?2004l[?2004h> dependencies = []
[?2004l[?2004h> def process_obs(surface_prefix, filename):
[?2004l[?2004h>     obs = [o for o in load_jsonl(f'case/{filename}') if o.get('result') == 'success' and o['observed_at'] <= cutoff]
[?2004l[?2004h>     obs.sort(key=lambda x: x['observed_at'], reverse=True)
[?2004l[?2004h>     for c_id, c in required_consumers.items():
[?2004l[?2004h>         if c.get('surface', '').startswith(surface_prefix):
[?2004l[?2004h>             subs = active_bindings.get(c_id, set())
[?2004l[?2004h>             eff_algs, eff_mats, eff_evid = set(), set(), set()
[?2004l[?2004h>             for sub in subs:
[?2004l[?2004h>                 for o in obs:
[?2004l[?2004h>                     if o.get('subject') == sub:
[?2004l[?2004h>                         eff_algs.update(o.get('algorithms', []))
[?2004l[?2004h>                         if 'protocol' in o: eff_algs.add(o['protocol'])
[?2004l[?2004h>                         eff_mats.update(o.get('materials', []))
[?2004l[?2004h>                         eff_evid.add(o['id'])
[?2004l[?2004h>                         break
[?2004l[?2004h>             if eff_evid:
[?2004l[?2004h>                 dependencies.append({
[?2004l[?2004h>                     "surface": c['surface'], "consumer": c_id,
[?2004l[?2004h>                     "effective_algorithms": sorted(list(eff_algs)),
[?2004l[?2004h>                     "materials": sorted(list(eff_mats)), "evidence": sorted(list(eff_evid))
[?2004l[?2004h>                 })
[?2004l[?2004h> 
[?2004l[?2004h> process_obs('tls:', 'tls-negotiations.jsonl')
[?2004l[?2004h> process_obs('signing:', 'signature-verifications.jsonl')
[?2004l[?2004h> process_obs('ssh:', 'ssh-sessions.jsonl')
[?2004l[?2004h> 
[?2004l[?2004h> for a in archives:
[?2004l[?2004h>     dependencies.append({
[?2004l[?2004h>         "surface": a['surface'], "consumer": a['id'],
[?2004l[?2004h>         "effective_algorithms": sorted([a['data_cipher'], a['wrap_algorithm']]),
[?2004l[?2004h>         "materials": [a['wrap_material']], "evidence": [a['evidence']]
[?2004l on_interrupt=c[[?2004h>     })
[?2004l[?2004h> 
[?2004l[?2004h> # Final policies
[?2004l[?2004h> final_policies = {
[?2004l[?2004h>     "tls:telemetry-api": {
[?2004l[?2004h>         "minimum_protocol": "TLS1.3",
[?2004l[?2004h>         "allowed_kex": ["X25519_MLKEM768"],
[?2004l[?2004h>         "allowed_server_credentials": ["ECDSA_P384_SHA384"],
[?2004l[?2004h>         "trusted_roots": ["ECDSA_P384_SHA384"],
[?2004l[?2004h>         "reject_downgrade": True
[?2004l[?2004h>     },
[?2004l[?2004h>     "signing:device-update": {
[?2004l[?2004h>         "required_signers": ["ED25519", "ML_DSA_65"],
[?2004l[?2004h>         "allowed_algorithms": ["ED25519", "ML_DSA_65"],
[?2004l[?2004h>         "threshold": 2,
[?2004l[?2004h>         "context": "helios-release-v2",
[?2004l[?2004h>         "reject_revoked": True
[?2004l[?2004h>     },
[?2004l[?2004h>     "ssh:ops-bastion": {
[?2004l[?2004h>         "allowed_host_keys": ["SSH_ED25519"],
[?2004l[?2004h>         "allowed_user_cas": ["SSH_ED25519"],
[?2004l[?2004h>         "allowed_signature_algorithms": ["SSH_ED25519"],
[?2004l[?2004h>         "strict_host_identity": True,
[?2004l[?2004h>         "reject_sha1": True
[?2004l":[?2004h>     },
[?2004l[?2004h>     "archive:compliance": {
[?2004l[?2004h>         "data_cipher": "AES_256_GCM",
[?2004l[?2004h>         "wrap_algorithm": "X25519_MLKEM768",
[?2004l[?2004h>         "wrap_material": "archive-wrap-hybrid",
[?2004l[?2004h>         "require_aead": True
[?2004l[?2004h>     }
[?2004l[?2004h> }
[?2004l[?2004h> 
[?2004l[?2004h> final_mats = ["tls-root-2027", "tls-api-2027", "sign-release-ed", "sign-release-pq", "ssh-host-ed25519-c", "ssh-user-ca-ed-c", "archive-wrap-hybrid"]
[?2004l[?2004h> 
[?2004ll[?2004h> actions = []
[?2004l[?2004h> action_idx = 1
[?2004l[?2004h> def act(op, **kwargs):
[?2004l[?2004h>     global action_idx
