[?2004h[01;32manalyst@b71c3b4d1a4e[00m:[01;34m/app[00m$ cat << 'EOF' > generate_plan.py
[?2004l[?2004h> import json, hashlib, hmac
[?2004l[?2004h> 
[?2004l[?2004h> def sha256(b): return hashlib.sha256(b).hexdigest()
[?2004l[?2004h> def hmac256(k_hex, b): return hmac.new(bytes.fromhex(k_hex), b, hashlib.sha256).hexdigest()
[?2004l[?2004h> 
[?2004l[?2004h> def load_json(p): 
[?2004l[?2004h>     with open(p) as f: return json.load(f)
[?2004l[?2004h> def load_jsonl(p):
[?2004l[?2004h>     with open(p) as f: return [json.loads(l) for l in f if l.strip()]
[?2004l[?2004h> 
[?2004l[?2004h> estate = load_json('/opt/crypto-case/case/estate.json')
[?2004l[?2004h> captured_at = estate['captured_at']
[?2004l[?2004h> 
[?2004l[?2004h> # DEPENDENCIES AND FINDINGS
[?2004l[?2004h> events = load_jsonl('/opt/crypto-case/case/deployment-events.jsonl')
[?2004l[?2004h> events.sort(key=lambda x: x['time'])
[?2004l[?2004h> active_subjects = {}
[?2004l[?2004h> for ev in events:
[?2004l[?2004h>     if ev['time'] > captured_at: continue
[?2004l[?2004h>     subj = ev['subject']; cons = ev['consumer']
[?2004l[?2004h>     if ev['event'] == 'bind': active_subjects.setdefault(cons, set()).add(subj)
[?2004l[?2004h>     elif ev['event'] == 'unbind':
[?2004l[?2004h>         if cons in active_subjects and subj in active_subjects[cons]:
[?2004l[?2004h>             active_subjects[cons].remove(subj)
[?2004l[?2004h> 
[?2004l[?2004h> obs = []
[?2004l[?2004h> obs.extend(load_jsonl('/opt/crypto-case/case/tls-negotiations.jsonl'))
[?2004l[?2004h> obs.extend(load_jsonl('/opt/crypto-case/case/signature-verifications.jsonl'))
[?2004l[?2004h> obs.extend(load_jsonl('/opt/crypto-case/case/ssh-sessions.jsonl'))
[?2004l[?2004h> valid_obs = [o for o in obs if o['result'] == 'success' and o['observed_at'] <= captured_at]
[?2004l[?2004h> valid_obs.sort(key=lambda x: x['observed_at'], reverse=True)
[?2004l[?2004h> 
[?2004l[?2004h> deps = []
[?2004l[?2004h> for cons_info in estate['consumers']:
[?2004l[?2004h>     cons_id = cons_info['id']; surface = cons_info['surface']
[?2004l[?2004h>     if not cons_info.get('required') or surface.startswith('archive:'): continue
[?2004l[?2004h>     subjects = active_subjects.get(cons_id, set())
[?2004l[?2004h>     cons_algs = set(); cons_mats = set(); cons_ev = set()
[?2004l[?2004h>     for subj in subjects:
[?2004l[?2004h>         for o in valid_obs:
[?2004l[?2004h>             if o['surface'] == surface and o['subject'] == subj:
[?2004l[?2004h>                 cons_algs.update(o['algorithms']); cons_mats.update(o.get('materials', [])); cons_ev.add(o['id'])
[?2004l[?2004h>                 break
[?2004l[?2004h>     if cons_ev:
[?2004l[?2004h>         deps.append({'surface': surface, 'consumer': cons_id, 'effective_algorithms': sorted(list(cons_algs)), 'materials': sorted(list(cons_mats)), 'evidence': sorted(list(cons_ev))})
