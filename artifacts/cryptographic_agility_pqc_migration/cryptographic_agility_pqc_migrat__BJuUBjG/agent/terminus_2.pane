[?2004h[01;32manalyst@b71c3b4d1a4e[00m:[01;34m/app[00m$ cat << 'EOF' > parse_deps.py
[?2004l[?2004h> import json, sys
[?2004l[?2004h> 
[?2004l[?2004h> def load_json(p): 
[?2004l[?2004h>     with open(p) as f: return json.load(f)
[?2004l[?2004h> def load_jsonl(p):
[?2004l[?2004h>     with open(p) as f: return [json.loads(l) for l in f if l.strip()]
[?2004l[?2004h> 
[?2004l[?2004h> estate = load_json('/opt/crypto-case/case/estate.json')
[?2004l[?2004h> captured_at = estate['captured_at']
[?2004l[?2004h> 
[?2004l[?2004h> events = load_jsonl('/opt/crypto-case/case/deployment-events.jsonl')
[?2004l[?2004h> events.sort(key=lambda x: x['timestamp'])
[?2004l[?2004h> 
[?2004l[?2004h> # Reconstruct active subjects per consumer
[?2004l[?2004h> # consumer -> set(subjects)
[?2004l[?2004h> active_subjects = {}
[?2004l[?2004h> for ev in events:
[?2004l[?2004h>     if ev['timestamp'] > captured_at: continue
[?2004l[?2004h>     subj = ev['subject']
[?2004l[?2004h>     cons = ev['consumer']
[?2004l[?2004h>     if ev['event'] == 'bind':
[?2004l[?2004h>         active_subjects.setdefault(cons, set()).add(subj)
[?2004l[?2004h>     elif ev['event'] == 'unbind':
[?2004l[?2004h>         if cons in active_subjects and subj in active_subjects[cons]:
[?2004l[?2004h>             active_subjects[cons].remove(subj)
[?2004l[?2004h> 
[?2004l[?2004h> # Load observations
[?2004l[?2004h> obs = []
[?2004l[?2004h> obs.extend(load_jsonl('/opt/crypto-case/case/tls-negotiations.jsonl'))
[?2004l[?2004h> obs.extend(load_jsonl('/opt/crypto-case/case/signature-verifications.jsonl'))
[?2004l[?2004h> obs.extend(load_jsonl('/opt/crypto-case/case/ssh-sessions.jsonl'))
[?2004l[?2004h> 
[?2004l[?2004h> # Filter to success <= captured_at
[?2004l[?2004h> valid_obs = [o for o in obs if o['result'] == 'success' and o['observed_at'] <= captured_at]
[?2004l[?2004h> valid_obs.sort(key=lambda x: x['observed_at'], reverse=True)
[?2004l[?2004h> 
[?2004l[?2004h> deps = []
[?2004l[?2004h> for cons_info in estate['consumers']:
[?2004l[?2004h>     cons_id = cons_info['id']
[?2004l[?2004h>     surface = cons_info['surface']
[?2004l[?2004h>     # only process TLS, signing, SSH required consumers
[?2004l[?2004h>     if not cons_info.get('required'): continue
[?2004l[?2004h>     if surface.startswith('archive:'): continue
[?2004l[?2004h>     
[?2004l[?2004h>     subjects = active_subjects.get(cons_id, set())
[?2004l[?2004h>     
[?2004l[?2004h>     cons_algs = set()
[?2004l[?2004h>     cons_mats = set()
[?2004l[?2004h>     cons_ev = set()
[?2004l[?2004h>     
[?2004l[?2004h>     for subj in subjects:
[?2004l[?2004h>         # find latest
[?2004l[?2004h>         for o in valid_obs:
[?2004l[?2004h>             if o['surface'] == surface and o['subject'] == subj:
[?2004l[?2004h>                 cons_algs.update(o['algorithms'])
[?2004l[?2004h>                 cons_mats.update(o.get('materials', []))
[?2004l[?2004h>                 cons_ev.add(o['id'])
[?2004l[?2004h>                 break
[?2004l[?2004h>                 
[?2004l[?2004h>     if cons_ev:
[?2004l[?2004h>         deps.append({
[?2004l[?2004h>             'surface': surface,
[?2004l[?2004h>             'consumer': cons_id,
[?2004l[?2004h>             'effective_algorithms': sorted(list(cons_algs)),
[?2004l[?2004h>             'materials': sorted(list(cons_mats)),
[?2004l[?2004h>             'evidence': sorted(list(cons_ev))
[?2004l[?2004h>         })
[?2004l[?2004h> 
[?2004l[?2004h> archives = load_json('/opt/crypto-case/case/archives.json')
[?2004l[?2004h> for arc in archives:
[?2004l[?2004h>     deps.append({
[?2004l[?2004h>         'surface': arc['surface'],
[?2004l[?2004h>         'consumer': arc['id'],
[?2004l[?2004h>         'effective_algorithms': sorted([arc['data_cipher'], arc['wrap_algorithm']]),
[?2004l[?2004h>         'materials': [arc['wrap_material']],
[?2004l[?2004h>         'evidence': [arc['evidence']]
[?2004l[?2004h>     })
[?2004l[?2004h> 
[?2004l[?2004h> incidents = load_json('/opt/crypto-case/case/incident-evidence.json')
[?2004l[?2004h> compromised = set()
[?2004l[?2004h> for inc in incidents:
[?2004l[?2004h>     if inc['confidence'] == 'confirmed' and inc['type'] in ['material_export', 'unauthorized_signing_session']:
[?2004l[?2004h>         compromised.update(inc['materials'])
[?2004l[?2004h> 
[?2004l[?2004h> materials = load_json('/opt/crypto-case/case/materials.json')
[?2004l[?2004h> retire = set()
[?2004l[?2004h> for mat_id, mat in materials.items():
[?2004l[?2004h>     if mat.get('disposition') == 'retire_at_completion':
[?2004l[?2004h>         retire.add(mat_id)
[?2004l[?2004h> 
[?2004l[?2004h> out = {
