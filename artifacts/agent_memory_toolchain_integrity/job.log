Sending keys: ['cat << \'EOF\' > /app/submission/boundary_guard.py\nimport sys, json\n\ndef evaluate(d):\n    req = d.get(\'request\', {})\n    reg_list = [r for r in d.get(\'registry\', []) if r.get(\'plugin_id\') == req.get(\'plugin_id\') and r.get(\'status\') == \'active\' and r.get(\'catalog_trust\') == \'signed\' and r.get(\'catalog_signature_valid\')]\n    if len(reg_list) != 1: return False\n    reg = reg_list[0]\n    \n    if req.get(\'capability\') != reg.get(\'capability\'): return False\n    \n    cred_list = [c for c in d.get(\'credentials\', []) if c.get(\'id\') == req.get(\'credential_id\') and c.get(\'status\') == \'active\']\n    if len(cred_list) != 1: return False\n    cred = cred_list[0]\n    \n    if req.get(\'plugin_id\') not in cred.get(\'plugin_ids\', []): return False\n    if not set(reg.get(\'required_scopes\', [])).issubset(set(cred.get(\'scopes\', []))): return False\n    \n    dests = req.get(\'destinations\', [])\n    if not dests or dests[0] != req.get(\'target\'): return False\n    for dest in dests:\n        if not any(dest == a or (a.startswith(\'*.\') and dest.endswith(a[1:])) for a in reg.get(\'allowed_hosts\', [])): return False\n        \n    mems = {m[\'id\']: m for m in d.get(\'memories\', [])}\n    srcs = {s[\'id\']: s for s in d.get(\'sources\', [])}\n    state = {}\n    \n    def dfs(m_id):\n        if state.get(m_id) == 1: return False\n        if state.get(m_id) == 2: return True\n        state[m_id] = 1\n        if m_id not in mems: return False\n        m = mems[m_id]\n        if m.get(\'status\') != \'active\': return False\n        for s_id in m.get(\'source_ids\', []):\n            if s_id not in srcs: return False\n            s = srcs[s_id]\n            if s.get(\'status\') != \'active\': return False\n            if reg.get(\'risk\') == \'high\' and (s.get(\'trust\') != \'signed\' or not s.get(\'signature_valid\')): return False\n        for p_id in (m.get(\'parent_memory_ids\') or []):\n            if not dfs(p_id): return False\n        state[m_id] = 2\n        return True\n\n    for m_id in req.get(\'memory_ids\', []):\n        if not dfs(m_id): return False\n        \n    if reg.get(\'risk\') == \'high\':\n        app_list = [a for a in d.get(\'approvals\', []) if a.get(\'id\') == req.get(\'approval_id\') and a.get(\'status\') == \'active\']\n        if len(app_list) != 1: return False\n        app = app_list[0]\n        if app.get(\'type\') != \'change_ticket\': return False\n        if app.get(\'plugin_id\') != req.get(\'plugin_id\'): return False\n        if app.get(\'capability\') != req.get(\'capability\'): return False\n        if app.get(\'target\') != req.get(\'target\'): return False\n        if app.get(\'args_digest\') != req.get(\'args_digest\'): return False\n        \n    if req.get(\'forwards_credential\'): return False\n    return True\n\ndef check():\n    for line in sys.stdin:\n        line = line.strip()\n        if not line: continue\n        try:\n            print(json.dumps({"decision": "allow" if evaluate(json.loads(line)) else "deny", "reasons": ["eval"]}))\n        except Exception:\n            print(json.dumps({"decision": "deny", "reasons": ["error"]}))\n\nif __name__ == \'__main__\': check()\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
Sending keys: ['cat << \'EOF\' > /app/submission/boundary_guard.py\nimport sys, json\n\nfor line in sys.stdin:\n    if not line.strip(): continue\n    try:\n        d = json.loads(line)\n        req = d.get("request") or {}\n        reasons = []\n        \n        srcs = {x["id"]: x for x in d.get("sources", [])}\n        mems = {x["id"]: x for x in d.get("memories", [])}\n        regs = [x for x in d.get("registry", []) if x.get("plugin_id") == req.get("plugin_id") and x.get("status") == "active"]\n        creds = {x["id"]: x for x in d.get("credentials", [])}\n        apps = {x["id"]: x for x in d.get("approvals", [])}\n        \n        if len(regs) != 1:\n            reasons.append("invalid registry")\n            print(json.dumps({"decision": "deny", "reasons": reasons}))\n            continue\n            \n        reg = regs[0]\n        if reg.get("catalog_trust") != "signed" or not reg.get("catalog_signature_valid"):\n            reasons.append("registry not signed")\n        if req.get("capability") != reg.get("capability"):\n            reasons.append("capability mismatch")\n            \n        c = creds.get(req.get("credential_id"))\n        if not c or c.get("status") != "active":\n            reasons.append("invalid credential")\n        elif req.get("plugin_id") not in c.get("plugin_ids", []):\n            reasons.append("credential not bound")\n        elif not set(reg.get("required_scopes", [])).issubset(set(c.get("scopes", []))):\n            reasons.append("missing scopes")\n            \n        dests = req.get("destinations", [])\n        if not dests or dests[0] != req.get("target"):\n            reasons.append("invalid target")\n        for dest in dests:\n            matched = False\n            for a in reg.get("allowed_hosts", []):\n                if a.startswith("*.") and dest.endswith(a[1:]) and len(dest) > len(a[1:]):\n                    matched = True\n                elif dest == a:\n                    matched = True\n            if not matched:\n                reasons.append("unauthorized destination")\n        \n        def check_m(mid, vis):\n            if mid in vis: return False\n            vis.add(mid)\n            m = mems.get(mid)\n            if not m or m.get("status") != "active": return False\n            for sid in m.get("source_ids", []):\n                s = srcs.get(sid)\n                if not s or s.get("status") != "active": return False\n                if reg.get("risk") == "high":\n                    if s.get("trust") != "signed" or not s.get("signature_valid"): return False\n            for pmid in m.get("parent_memory_ids", []):\n                if not check_m(pmid, set(vis)): return False\n            return True\n            \n        for mid in req.get("memory_ids", []):\n            if not check_m(mid, set()):\n                reasons.append("invalid memory lineage")\n                \n        if reg.get("risk") == "high":\n            app = apps.get(req.get("approval_id"))\n            if not app or app.get("status") != "active":\n                reasons.append("invalid approval")\n            elif app.get("type") != "change_ticket":\n                reasons.append("wrong approval type")\n            elif app.get("plugin_id") != req.get("plugin_id"):\n                reasons.append("approval plugin mismatch")\n            elif app.get("capability") != req.get("capability"):\n                reasons.append("approval cap mismatch")\n            elif app.get("target") != req.get("target"):\n                reasons.append("approval target mismatch")\n            elif app.get("args_digest") != req.get("args_digest"):\n                reasons.append("approval args mismatch")\n                \n        if req.get("forwards_credential"):\n            reasons.append("credential forwarded")\n            \n        print(json.dumps({"decision": "allow" if not reasons else "deny", "reasons": reasons}))\n    except Exception as e:\n        print(json.dumps({"decision": "deny", "reasons": [str(e)]}))\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
Sending keys: ['cat << \'EOF\' > /app/submission/boundary_guard.py\nimport sys\nimport json\nimport urllib.parse\n\ndef main():\n    for line in sys.stdin:\n        if not line.strip():\n            continue\n        try:\n            env = json.loads(line)\n            result = evaluate(env)\n            print(json.dumps(result))\n        except Exception as e:\n            print(json.dumps({"decision": "deny", "reasons": [f"Error: {str(e)}"]}))\n\ndef evaluate(env):\n    sources = {s[\'id\']: s for s in env.get(\'sources\', [])}\n    memories = {m[\'id\']: m for m in env.get(\'memories\', [])}\n    registry = {r[\'plugin_id\']: r for r in env.get(\'registry\', [])}\n    credentials = {c[\'id\']: c for c in env.get(\'credentials\', [])}\n    approvals = {a[\'id\']: a for a in env.get(\'approvals\', [])}\n    req = env.get(\'request\', {})\n    \n    reasons = []\n    \n    plugin_id = req.get(\'plugin_id\')\n    if plugin_id not in registry:\n        return {"decision": "deny", "reasons": ["Plugin not registered"]}\n    reg = registry[plugin_id]\n    \n    if reg.get(\'status\') != \'active\':\n        return {"decision": "deny", "reasons": ["Registry not active"]}\n    if reg.get(\'catalog_trust\') != \'signed\' or not reg.get(\'catalog_signature_valid\'):\n        return {"decision": "deny", "reasons": ["Registry not signed or invalid signature"]}\n    if req.get(\'capability\') != reg.get(\'capability\'):\n        return {"decision": "deny", "reasons": ["Capability mismatch"]}\n        \n    cred_id = req.get(\'credential_id\')\n    if cred_id not in credentials:\n        return {"decision": "deny", "reasons": ["Credential missing"]}\n    cred = credentials[cred_id]\n    if cred.get(\'status\') != \'active\':\n        return {"decision": "deny", "reasons": ["Credential not active"]}\n    if plugin_id not in cred.get(\'plugin_ids\', []):\n        return {"decision": "deny", "reasons": ["Credential not bound to plugin"]}\n    \n    required_scopes = set(reg.get(\'required_scopes\', []))\n    provided_scopes = set(cred.get(\'scopes\', []))\n    if not required_scopes.issubset(provided_scopes):\n        return {"decision": "deny", "reasons": ["Missing scopes"]}\n        \n    dests = req.get(\'destinations\', [])\n    allowed_hosts = reg.get(\'allowed_hosts\', [])\n    if not dests:\n        return {"decision": "deny", "reasons": ["No destinations"]}\n    if dests[0] != req.get(\'target\'):\n        return {"decision": "deny", "reasons": ["First destination is not the target"]}\n        \n    for d in dests:\n        matched = False\n        for ah in allowed_hosts:\n            if ah.startswith(\'*.\') and d.endswith(ah[1:]):\n                matched = True\n                break\n            elif d == ah:\n                matched = True\n                break\n        if not matched:\n            return {"decision": "deny", "reasons": ["Destination not allowed"]}\n            \n    if req.get(\'forwards_credential\'):\n        return {"decision": "deny", "reasons": ["Credential forwarding forbidden"]}\n        \n    risk = reg.get(\'risk\')\n    approval_id = req.get(\'approval_id\')\n    if risk == \'high\':\n        if not approval_id or approval_id not in approvals:\n            return {"decision": "deny", "reasons": ["Approval missing for high risk"]}\n        appr = approvals[approval_id]\n        if appr.get(\'status\') != \'active\' or appr.get(\'type\') != \'change_ticket\':\n            return {"decision": "deny", "reasons": ["Invalid approval type"]}\n        if appr.get(\'plugin_id\') != plugin_id or appr.get(\'capability\') != req.get(\'capability\'):\n            return {"decision": "deny", "reasons": ["Approval capability mismatch"]}\n        if appr.get(\'target\') != req.get(\'target\') or appr.get(\'args_digest\') != req.get(\'args_digest\'):\n            return {"decision": "deny", "reasons": ["Approval target/args mismatch"]}\n            \n    def check_memory(mem_id):\n        if mem_id not in memories:\n            return False\n        mem = memories[mem_id]\n        if mem.get(\'status\') != \'active\':\n            return False\n        for src_id in mem.get(\'source_ids\', []):\n            if src_id not in sources:\n                return False\n            src = sources[src_id]\n            if src.get(\'status\') != \'active\':\n                return False\n            if risk == \'high\' and (src.get(\'trust\') != \'signed\' or not src.get(\'signature_valid\')):\n                return False\n        for p_mem_id in mem.get(\'parent_memory_ids\', []):\n            if not check_memory(p_mem_id):\n                return False\n        return True\n        \n    for mem_id in req.get(\'memory_ids\', []):\n        if not check_memory(mem_id):\n            return {"decision": "deny", "reasons": ["Lineage invalid"]}\n            \n    return {"decision": "allow", "reasons": []}\n\nif __name__ == \'__main__\':\n    sys.setrecursionlimit(2000)\n    main()\nEOF\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
