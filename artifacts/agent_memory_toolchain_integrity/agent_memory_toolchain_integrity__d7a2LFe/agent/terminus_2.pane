[?2004l[?2004h> malicious_mems = ['mem-794a0f2a', 'mem-1c6800b6', 'mem-ed874ee6', 'mem-1876d59c']
[?2004l[?2004h> 
[?2004l[?2004h> event_ids = []
[?2004l[?2004h> for event in audit:
