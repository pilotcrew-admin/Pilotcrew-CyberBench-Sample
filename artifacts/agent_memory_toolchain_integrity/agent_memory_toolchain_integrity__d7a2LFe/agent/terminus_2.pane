[?2004l[?2004h>     elif event.get('memory_id') in malicious_mems:
[?2004l[?2004h>         event_ids.append(event['id'])
[?2004l[?2004h>     elif event.get('plugin_id') == 'plg-dae19400' and event.get('metadata_source_id') == 'src-4e2d7f55':
[?2004l[?2004h>         event_ids.append(event['id'])
[?2004l[?2004h>     elif event.get('action_id') == 'act-995aacfa':
