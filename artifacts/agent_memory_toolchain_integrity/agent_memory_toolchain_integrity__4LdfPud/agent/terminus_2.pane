[?2004l[?2004h> import json
[?2004l[?2004h> import subprocess
[?2004l[?2004h> 
[?2004l[?2004h> def get_audit_ids():
[?2004l[?2004h>     cmd = "jq -r '.[] | select([.[]? | if type == \"array\" then .[] else . end] | any(. == \"src-d734686e\" or . == \"src-4e2d7f55\" or . == \"mem-794a0f2a\" or . == \"mem-1c6800b6\" or . == \"mem-ed874ee6\" or . == \"mem-1876d59c\" or . == \"act-995aacfa\" or . == \"cred-a21024a9\")) | .id' /app/audit.json"
[?2004l[?2004h>     result = subprocess.run(cmd, shell=True, capture_output=True, text=True)
[?2004l[?2004h>     return [line.strip() for line in result.stdout.split('\n') if line.strip()]
